# Canonical origin. Every canonical URL, hreflang, sitemap entry, OG image URL
# and JSON-LD @id is built from this, so set it before deploying.
NEXT_PUBLIC_SITE_URL=https://josamcode.com

# Contact form delivery (optional).
# Without RESEND_API_KEY the API accepts the submission and tells the browser
# to open the visitor's mail client with the message pre-filled, so the form
# still works with no configuration at all.
RESEND_API_KEY=
CONTACT_FROM=Portfolio <onboarding@resend.dev>
CONTACT_TO=josamcode@gmail.com
